{
	"name": "starsync",
	"version": "1.2.0",
	"private": true,
	"packageManager": "bun@1.3.14",
	"author": "NomadicDaddy",
	"description": "Automatically synchronize all your starred GitHub repositories on your local drive. If a repository already exists, it will be pulled to the newest commit, otherwise it will be cloned.",
	"dependencies": {
		"@octokit/rest": "^22.0.1"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@types/bun": "1.3.14",
		"eslint": "10.7.0",
		"eslint-plugin-perfectionist": "5.10.0",
		"eslint-plugin-unused-imports": "4.4.1",
		"globals": "17.7.0",
		"prettier": "3.9.5",
		"prettier-plugin-organize-attributes": "1.0.0",
		"prettier-plugin-sort-json": "4.2.0",
		"typescript": "6.0.3",
		"typescript-eslint": "8.64.0"
	},
	"engines": {
		"bun": ">=1.3.14"
	},
	"scripts": {
		"build": "bun build ./src/cli.ts --target=bun --outdir=dist",
		"compile": "bun build ./src/cli.ts --compile --outfile=dist/starsync",
		"format": "prettier --write \"src/**/*.ts\" \"scripts/**/*.ts\" \"test/**/*.ts\"",
		"format:check": "prettier --check \"src/**/*.ts\" \"scripts/**/*.ts\" \"test/**/*.ts\"",
		"lint": "eslint \"src/**/*.ts\" \"scripts/**/*.ts\" \"test/**/*.ts\" --max-warnings 0",
		"lint:fix": "eslint --fix \"src/**/*.ts\" \"scripts/**/*.ts\" \"test/**/*.ts\" --max-warnings 0",
		"smoke:qc": "bun run typecheck && bun run lint && bun run format:check && bun test",
		"start": "bun src/cli.ts",
		"sync": "bun ./src/cli.ts",
		"test": "bun test",
		"typecheck": "tsc --noEmit",
		"preinstall": "bun scripts/require-bun.ts"
	},
	"type": "module",
	"bin": {
		"starsync": "./src/cli.ts"
	},
	"main": "./src/index.ts",
	"module": "./src/index.ts",
	"types": "./src/index.ts",
	"files": [
		"src",
		"scripts",
		"README.md",
		"LICENSE"
	],
	"keywords": [
		"github",
		"sync",
		"starred",
		"repositories",
		"clone",
		"pull"
	],
	"license": "MIT"
}
