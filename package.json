{
	"name": "starsync",
	"version": "2.1.0",
	"packageManager": "bun@1.3.14",
	"author": "NomadicDaddy",
	"description": "Automatically synchronize all your starred GitHub repositories on your local drive. If a repository already exists, it will be pulled to the newest commit, otherwise it will be cloned.",
	"dependencies": {
		"@octokit/rest": "^22.0.1"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@types/bun": "1.3.14",
		"eslint": "10.8.0",
		"eslint-plugin-perfectionist": "5.10.0",
		"eslint-plugin-unused-imports": "4.4.1",
		"globals": "17.8.0",
		"prettier": "3.9.6",
		"prettier-plugin-organize-attributes": "1.0.0",
		"prettier-plugin-sort-json": "4.2.0",
		"typescript": "6.0.3",
		"typescript-eslint": "8.65.0"
	},
	"engines": {
		"bun": ">=1.3.14",
		"node": ">=24.0.0"
	},
	"scripts": {
		"build": "bun run build:bundle && bun run build:types",
		"build:bundle": "bun build ./src/cli.ts ./src/index.ts --target=node --outdir=dist --packages=external",
		"build:types": "tsc -p tsconfig.types.json",
		"check:max-lines": "bun ./scripts/check-max-lines.ts",
		"compile": "bun build ./src/cli.ts --compile --outfile=dist/starsync",
		"deploy": "bun run compile",
		"format": "prettier --write \"src/**/*.ts\" \"scripts/**/*.ts\" \"test/**/*.ts\"",
		"format:check": "prettier --check \"src/**/*.ts\" \"scripts/**/*.ts\" \"test/**/*.ts\"",
		"lint": "eslint src scripts test eslint.config.js --max-warnings 0",
		"lint:fix": "eslint src scripts test eslint.config.js --fix --max-warnings 0",
		"smoke:live": "bun ./scripts/live-smoke.ts",
		"smoke:qc": "bun run check:max-lines && bun run typecheck && bun run lint && bun run format:check && bun run test",
		"start": "bun ./src/cli.ts",
		"sync": "bun ./src/cli.ts sync",
		"test": "bun ./scripts/test.ts",
		"typecheck": "tsc --noEmit",
		"prepare": "bun ./scripts/require-bun.ts && bun run build",
		"prepublishOnly": "bun run smoke:qc"
	},
	"type": "module",
	"bin": {
		"starsync": "./dist/cli.js"
	},
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/types/index.d.ts",
	"files": [
		"dist/cli.js",
		"dist/index.js",
		"dist/types",
		"README.md",
		"LICENSE"
	],
	"keywords": [
		"github",
		"sync",
		"starred",
		"repositories",
		"clone",
		"pull"
	],
	"license": "MIT"
}
