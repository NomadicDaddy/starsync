# .env file — Bun auto-loads it

# GITHUB_TOKEN is used ONLY for the GitHub API (listing starred repos).
# Git clone/pull authentication uses your system Git credentials
# (Git Credential Manager or SSH keys), never the token.
GITHUB_TOKEN=your_personal_access_token_here

# Codeberg API token, separate from Git transport credentials.
CODEBERG_TOKEN=your_codeberg_token_here

# Separate archive defaults. --host selects one; no --host defaults to GitHub.
# A positional path overrides these values.
# TARGET_PATH_GITHUB=D:/github
# TARGET_PATH_CODEBERG=D:/codeberg

# GitHub-only fallback when TARGET_PATH_GITHUB is absent (not empty).
# TARGET_PATH=D:/github
