# .env file — Bun auto-loads it

# GITHUB_TOKEN is used ONLY for the GitHub API (listing starred repos).
# Git clone/pull authentication uses your system Git credentials
# (Git Credential Manager or SSH keys), never the token.
GITHUB_TOKEN=your_personal_access_token_here

# Optional in the current major: defaults to <starsync-project>/starred_repos.
# This value or an explicit target path will be required in the next major release.
# TARGET_PATH=/path/to/your/sync/folder
